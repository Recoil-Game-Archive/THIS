<rml>
<head>
	<title>THIS game menu</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		/* A small handle next to the top bar, and the menu it (or Esc) opens. */
		#menu-button {
			position: absolute;
			top: 8dp;
			left: 50%;
			margin-left: 288dp;
			pointer-events: auto;
			font-size: 11dp;
			letter-spacing: 1dp;
			color: #8c9bb3;
			padding: 4dp 10dp 5dp 10dp;
		}
		#menu-button:hover {
			color: #e6edf7;
			border-color: #8c9bb3;
		}
		#backdrop {
			position: absolute;
			left: 0dp;
			top: 0dp;
			width: 100%;
			height: 100%;
			background-color: rgba(0, 0, 0, 120);
			pointer-events: auto;
		}
		#menu {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 300dp;
			margin-left: -150dp;
			margin-top: -200dp;
			pointer-events: auto;
		}
		#menu-head {
			padding: 12dp 16dp 4dp 16dp;
		}
		#menu-items {
			padding: 6dp 16dp 14dp 16dp;
		}
		#menu-items .button {
			margin-top: 6dp;
		}
		/* music: track name, then previous / pause / next */
		#music {
			margin: 4dp 16dp 0dp 16dp;
			padding: 8dp 10dp 10dp 10dp;
			background-color: rgba(255, 255, 255, 10);
			border-radius: 3dp;
		}
		#music-track {
			margin-top: 2dp;
			font-size: 14dp;
			font-weight: bold;
			color: #e6edf7;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		#music-buttons {
			display: flex;
			flex-direction: row;
			margin-top: 8dp;
		}
		#music-buttons .button {
			flex: 1;
			font-size: 12dp;
			padding: 4dp 4dp 5dp 4dp;
		}
		#mu-pause {
			margin: 0dp 6dp;
		}
		#confirm-text {
			margin-top: 14dp;
			font-size: 14dp;
			color: #e6edf7;
			text-align: center;
		}
	</style>
</head>
<body>
	<div id="menu-button" class="panel">MENU</div>

	<div id="backdrop" class="hidden"/>
	<div id="menu" class="panel hidden">
		<div id="menu-accent" class="accent-line"/>
		<div id="menu-head" class="title">GAME MENU</div>
		<div id="music" class="hidden">
			<div class="label">MUSIC</div>
			<div id="music-track"/>
			<div id="music-buttons">
				<div id="mu-prev" class="button quiet">Previous</div>
				<div id="mu-pause" class="button quiet">Pause</div>
				<div id="mu-next" class="button quiet">Next</div>
			</div>
		</div>
		<div id="menu-items">
			<div id="main-items">
				<div id="m-resume" class="button">Resume</div>
				<div id="m-pause" class="button quiet">Pause game</div>
				<div id="m-settings" class="button quiet">Settings</div>
				<div id="m-quit" class="button quiet">Quit</div>
			</div>
			<div id="confirm-items" class="hidden">
				<div id="confirm-text">Quit to the desktop?</div>
				<div id="m-quit-yes" class="button danger">Yes, quit</div>
				<div id="m-quit-no" class="button quiet">Cancel</div>
			</div>
		</div>
	</div>
</body>
</rml>
